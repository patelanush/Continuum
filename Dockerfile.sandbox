FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest==8.4.2 \
    && useradd --create-home --uid 10001 coder \
    && mkdir /workspace \
    && chown coder:coder /workspace

COPY --chown=coder:coder fixtures/coding/discount_service /opt/fixtures/discount_service
COPY src/durable_agent_runtime/coding/sandbox_tool.py /opt/sandbox_tool.py

USER 10001:10001
WORKDIR /workspace
CMD ["sleep", "infinity"]
