{
  "uid": "continuum-system-overview",
  "title": "Continuum \u2014 System Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "continuum",
    "local"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Workflow start rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(continuum_workflows_started_total[5m]))",
          "refId": "A",
          "legendFormat": "{{status}} {{step_type}} {{provider}} {{model}} {{tool_name}} {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Workflow completions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
