APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://durable:durable@postgres:5432/durable
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MOCK_PAYMENTS_URL=http://mock-payments:8001
EXECUTOR_LEASE_SECONDS=20
EXECUTOR_HEARTBEAT_SECONDS=4
RECOVERY_SCAN_INTERVAL_SECONDS=1
AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_ATTEMPTS=3
AGENT_MAX_TURNS=8
